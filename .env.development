# 비워 두면 /api 상대 경로로 요청하고 Vite proxy(vite.config.ts)가 백엔드로 전달한다.
VITE_API_BASE_URL=
# 실제 서버로 보낼 API 목록 (쉼표 구분, src/api/config.ts 의 키). 비우면 전부 목업.
# 예) VITE_REAL_APIS=auth.emailAvailable,auth.login
VITE_REAL_APIS=
# 로컬 proxy 대상. 로컬 백엔드 대신 개발 서버를 쓰려면 http://15.165.93.37:8080
VITE_DEV_PROXY_TARGET=http://localhost:8080
# 토스페이먼츠 클라이언트 키. 결제 API(payment.*)를 실제로 켤 때만 필요. 값은 .env.development.local 에 적는다 (테스트 키 test_ck_...)
VITE_TOSS_CLIENT_KEY=
