# env 키 구조. 값은 git 에 올리지 않는다.
# - 로컬: 이 파일을 복사해 .env.local 을 만든다 (cp .env.example .env.local)
# - 배포: Vercel 환경 변수에 같은 키로 넣는다 (바꾸면 재배포)

# 실제 서버로 보낼 API 목록 (쉼표 구분, src/api/registry.ts 의 키). 비우면 전부 목업.
# 예) VITE_REAL_APIS=auth.login,auction.detail
VITE_REAL_APIS=

# [로컬만] npm run dev 의 /api proxy 대상
VITE_DEV_PROXY_TARGET=http://localhost:8091

# 카카오 REST API 키 (카카오 로그인 인가 요청의 client_id). JavaScript 키가 아니다.
# 카카오 로그인(auth.kakaoLogin)을 실제로 켤 때만 필요. Client Secret 은 백엔드에만 둔다.
# Redirect URI 는 카카오 콘솔에 <사이트 주소>/oauth/kakao/callback 으로 등록돼 있어야 한다.
VITE_KAKAO_REST_API_KEY=

# 토스페이먼츠 클라이언트 키. 결제 API(payment.*)를 실제로 켤 때만 필요 (로컬은 테스트 키 test_ck_...)
VITE_TOSS_CLIENT_KEY=

# 거래 채팅 WebSocket 주소 (STOMP /ws/chat). 로컬은 비워 두면 Vite proxy(/ws → Gateway)로 붙는다.
# 배포는 비워 두면 wss://api.jjinmak.kro.kr 를 쓴다 (lib/chatSocket.ts)
VITE_WS_BASE_URL=
